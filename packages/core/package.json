{
  "name": "@describe-me/core",
  "version": "0.5.4",
  "description": "Living component documentation from your Vitest tests: the recorder and manifest types of describe-me",
  "keywords": [
    "vitest",
    "react",
    "storybook",
    "storybook alternative",
    "component documentation",
    "living documentation",
    "jsdom",
    "testing"
  ],
  "license": "MIT",
  "author": "Grzegorz Łotysz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzehub/describe-me.git",
    "directory": "packages/core"
  },
  "homepage": "https://grzehub.github.io/describe-me/",
  "bugs": "https://github.com/grzehub/describe-me/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./diagnostics": {
      "types": "./dist/manifest-diagnostics.d.ts",
      "default": "./dist/manifest-diagnostics.js"
    },
    "./css-references": {
      "types": "./dist/css-references.d.ts",
      "default": "./dist/css-references.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "rrweb-snapshot": "^2.1.6"
  }
}
