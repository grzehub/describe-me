{
  "name": "@describe-me/react",
  "version": "0.5.3",
  "description": "Living component documentation from your Vitest tests: the React adapter of describe-me",
  "keywords": [
    "vitest",
    "react",
    "storybook",
    "storybook alternative",
    "component documentation",
    "living documentation",
    "jsdom",
    "testing"
  ],
  "license": "MIT",
  "author": "Grzegorz Łotysz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzehub/describe-me.git",
    "directory": "packages/react"
  },
  "homepage": "https://grzehub.github.io/describe-me/",
  "bugs": "https://github.com/grzehub/describe-me/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing-library": {
      "types": "./dist/testing-library.d.ts",
      "default": "./dist/testing-library.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/render-testing-library.js"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@describe-me/core": "workspace:^"
  },
  "peerDependencies": {
    "@describe-me/vitest": "workspace:^",
    "@testing-library/react": "^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vitest-browser-react": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "vitest-browser-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@describe-me/vitest": "workspace:^",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
