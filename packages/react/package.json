{
  "name": "@describe-me/react",
  "version": "0.0.1",
  "description": "React adapter for describe-me: a drop-in render that records frames",
  "keywords": [
    "vitest",
    "storybook",
    "component documentation",
    "visual testing",
    "react",
    "testing"
  ],
  "license": "MIT",
  "author": "Grzegorz Łotysz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzehub/describe-me.git",
    "directory": "packages/react"
  },
  "homepage": "https://grzehub.github.io/describe-me/",
  "bugs": "https://github.com/grzehub/describe-me/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@describe-me/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "vitest-browser-react": ">=2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19.3.0",
    "vitest-browser-react": "^2.3.0",
    "vitest": "^5.0.1"
  }
}
