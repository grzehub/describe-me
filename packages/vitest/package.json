{
  "name": "@describe-me/vitest",
  "version": "0.3.0",
  "description": "Vitest integration for describe-me: plugin, setup file and reporter",
  "keywords": [
    "vitest",
    "storybook",
    "component documentation",
    "visual testing",
    "testing"
  ],
  "license": "MIT",
  "author": "Grzegorz Łotysz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzehub/describe-me.git",
    "directory": "packages/vitest"
  },
  "homepage": "https://grzehub.github.io/describe-me/",
  "bugs": "https://github.com/grzehub/describe-me/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./setup-dom": {
      "types": "./dist/setup-dom.d.ts",
      "default": "./dist/setup-dom.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/setup.js",
    "./dist/setup-dom.js"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@describe-me/core": "workspace:^"
  },
  "peerDependencies": {
    "vitest": ">=4",
    "typescript": ">=5.0",
    "@testing-library/user-event": ">=14"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@testing-library/user-event": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.1",
    "@types/node": "^22",
    "typescript": "^6",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/dom": "^10.4.0"
  }
}
