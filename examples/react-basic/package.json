{
  "name": "react-basic",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vitest & describe-me dev --data .describe-me; wait",
    "bench:micro": "BENCH_MICRO=1 vitest run",
    "bench:macro": "node bench/macro.mjs 5",
    "docs:dev": "describe-me dev --data .describe-me",
    "docs:build": "describe-me build --data .describe-me --out docs-dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@describe-me/core": "workspace:*",
    "@describe-me/react": "workspace:*",
    "@describe-me/viewer": "workspace:*",
    "@describe-me/vitest": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/browser-playwright": "^5.0.1",
    "playwright": "^1.63.0",
    "rrweb-snapshot": "^2.1.6",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
