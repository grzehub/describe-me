{
  "name": "describe-me-starter",
  "private": true,
  "type": "module",
  "description": "describe-me in jsdom, ready for StackBlitz: three components, their tests, the viewer with Live and Foundations",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vitest run; describe-me dev --data .describe-me",
    "build": "describe-me build --data .describe-me --out describe-me-dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@describe-me/react": "^0.11.0",
    "@describe-me/vitest": "^0.11.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "describe-me": "^0.11.0",
    "jsdom": "^26.1.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
